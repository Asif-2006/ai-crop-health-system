# ------------------------------------------------------------------------------
# Whitelist: Source Code, Reports, Figures, and Evaluation Outputs
# ------------------------------------------------------------------------------
# Allow evaluation outputs and report artifacts to be committed
!cv-service/evaluation_output/
!cv-service/evaluation_output/**
!cv-service/reports/
!cv-service/reports/**
!cv-service/test_images/
!cv-service/test_images/**

# Allow model configuration and documentation files
!cv-service/models/**/config.json
!cv-service/models/**/results.json
!cv-service/models/**/README.md
!cv-service/models/**/*.py

# Allow ML experiments, figures, and results
!ml-service/experiments/figures/
!ml-service/experiments/figures/**
!ml-service/experiments/results/
!ml-service/experiments/results/**
!ml-service/notebooks/*.ipynb

# ------------------------------------------------------------------------------
# Preserve .gitkeep Files Across All Directories
# ------------------------------------------------------------------------------
!.gitkeep
!*/.gitkeep
!**/.gitkeep
