# ==============================================================================
# Environment Configuration Template (.env.example)
# Project: AI-Based Crop Health Monitoring, Disease Detection and Agricultural Decision Support System
# Target Crop: Rice (Paddy)
#
# INSTRUCTIONS:
# Copy this file to .env before running services:
#   cp .env.example .env
# Replace placeholder values with your local development configurations.
# DO NOT commit .env files with real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# System & General Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / MongoDB)
# ------------------------------------------------------------------------------
# PostgreSQL Settings:
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crop_health_db
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# MongoDB Settings (Alternative):
# MONGODB_URI=mongodb://localhost:27017/crop_health_db

# ------------------------------------------------------------------------------
# Backend API & Authentication (Member 4)
# ------------------------------------------------------------------------------
BACKEND_HOST=localhost
BACKEND_PORT=5000
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Application (Member 4)
# ------------------------------------------------------------------------------
REACT_APP_API_BASE_URL=http://localhost:5000/api
REACT_APP_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Member 1: ML Service (Crop Disease Risk Prediction)
# ------------------------------------------------------------------------------
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://localhost:8001

# ------------------------------------------------------------------------------
# Member 2: CV Service (Rice Leaf Disease Detection & Severity Analysis)
# ------------------------------------------------------------------------------
CV_SERVICE_HOST=localhost
CV_SERVICE_PORT=8002
CV_SERVICE_URL=http://localhost:8002

# ------------------------------------------------------------------------------
# Member 3: Agricultural Decision Support & Recommendation Service
# ------------------------------------------------------------------------------
RECOMMENDATION_SERVICE_HOST=localhost
RECOMMENDATION_SERVICE_PORT=8003
RECOMMENDATION_SERVICE_URL=http://localhost:8003

# ------------------------------------------------------------------------------
# External Services & APIs (Placeholders)
# ------------------------------------------------------------------------------
WEATHER_API_KEY=your_weather_api_key_placeholder
WEATHER_API_URL=https://api.weatherapi.com/v1
